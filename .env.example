# ---------------------------------------------------------------------------
# FilmFund Africa - variables d'environnement
# Copier ce fichier vers .env et renseigner les valeurs.
# NE JAMAIS committer de cle API reelle.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=FilmFund Africa
ENVIRONMENT=development
DEBUG=true
DEFAULT_LOCALE=fr

# --- Cycle de vie de la plateforme ---
# internal : beta privee. Les contraintes COMMERCIALES (quota de projets,
#            credits IA, export) ne sont pas opposees aux administrateurs.
#            Tous les autres comptes gardent les regles de leur offre.
# public   : phase commerciale, les regles d'offre s'appliquent a tout le
#            monde, administrateurs compris.
#
# Ce reglage ne touche NI l'authentification, NI les roles, NI la propriete
# des ressources : « interne » veut dire sans facturation, pas sans controle.
# Le passage internal -> public est une decision explicite : changer cette
# valeur et redemarrer. Le retour arriere est identique et ne detruit rien.
PLATFORM_MODE=internal
# Reperes informatifs de la phase interne. AUCUNE bascule automatique :
# depasser la date cible ne change strictement rien.
INTERNAL_START_DATE=2026-09-19
INTERNAL_TARGET_END_DATE=2027-09-19

# --- Base de donnees ---
# Docker Compose : postgres ; local : localhost
POSTGRES_USER=filmfund
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=filmfund
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://filmfund:change_me_in_production@postgres:5432/filmfund
# Compatible Supabase / Neon :
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db?sslmode=require

# --- Securite ---
# OBLIGATOIRE en production : l'application refuse de demarrer avec la valeur
# de developpement ou un secret de moins de 32 caracteres.
#   openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
# Cle de chiffrement des secrets conserves en base (cles de fournisseur
# d'IA saisies depuis l'administration). Vide : derivee de JWT_SECRET.
# A connaitre : sans SECRETS_KEY, faire tourner JWT_SECRET rend les cles
# stockees illisibles et il faut les ressaisir depuis l'administration.
# Generer avec : openssl rand -hex 32
SECRETS_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=60
# Duree de validite du lien de confirmation d'adresse (24 h par defaut).
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
# IP des proxys inverses de confiance, separees par des virgules. Seules ces
# adresses sont autorisees a definir X-Forwarded-For ; laisser vide si l'API
# n'est pas derriere un proxy, sinon la limitation de debit est contournable.
TRUSTED_PROXY_IPS=

# --- Rate limiting ---
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120
# Vide : compteurs en memoire, propres a chaque processus. Avec plusieurs
# repliques, chacune applique alors sa propre limite : la limite reelle est
# multipliee par leur nombre. Renseignez REDIS_URL pour une limite partagee.
# docker compose fournit deja redis://redis:6379/0.
REDIS_URL=
# Au-dela de ce delai, l'appel a Redis est abandonne et compte en memoire :
# un Redis lent ne doit pas tenir les requetes ouvertes.
REDIS_TIMEOUT_SECONDS=0.25

# --- Taches de generation ---
# Avec REDIS_URL et un worker (`python -m app.workers.runner`), les generations
# sont executees hors requete HTTP. Sans l'un ou l'autre, l'API les execute
# elle-meme : c'est fonctionnel, mais un scenario long tient la requete ouverte.
# Duree SANS SIGNE DE VIE au-dela de laquelle une tache est consideree
# interrompue (worker disparu) : elle echoue et les credits sont rendus. Le
# worker touche la tache a chaque passe : une generation longue mais vivante
# n'est jamais prise pour une tache morte. Gardez ce seuil au-dessus de
# AI_TIMEOUT_SECONDS, qui borne la duree d'une passe.
JOB_TIMEOUT_SECONDS=900
# Age a partir duquel une tache en attente est reprise par le balayage.
JOB_STALE_SECONDS=60

# --- Observabilite (Sentry) ---
# Vide : aucun suivi d'erreurs, aucune requete vers un tiers. C'est le defaut.
# Renseigne : les exceptions du backend et du worker partent chez Sentry, apres
# expurgation. Identifiants, adresses e-mail, numeros de telephone, jetons dans
# les URL et contenu des dossiers (synopsis, scenarios, budgets) sont retires
# avant l'envoi ; le corps des requetes et les variables locales ne sont jamais
# joints. Voir backend/app/core/observability.py.
SENTRY_DSN=
# Environnement affiche dans Sentry ; reprend ENVIRONMENT si vide.
SENTRY_ENVIRONMENT=
# Version deployee, pour rattacher une erreur a un lot de code.
SENTRY_RELEASE=
# Part des requetes tracees pour la performance. 0 = aucune : le suivi
# d'erreurs n'en a pas besoin, et les traces coutent cher.
SENTRY_TRACES_SAMPLE_RATE=0

# --- Paiements et abonnements ---
# `manual` : encaissement hors ligne, valide depuis l'administration (defaut).
# `mock`   : prestataire simule, developpement uniquement (refuse en production).
# Brancher un prestataire reel revient a ajouter une classe dans
# app/services/payments/ et a mettre son nom ici.
PAYMENT_PROVIDER=manual
# Secret partage avec le prestataire, qui signe ses notifications. Sans lui,
# aucune notification n'est acceptee.
PAYMENT_WEBHOOK_SECRET=

# --- IA ---
# AI_PROVIDER : anthropic | openai | mock
# Deux fournisseurs reels au choix, plus "mock" qui ne fait aucun appel
# reseau : utile pour les tests et la demo hors ligne.
AI_PROVIDER=mock
# Peut aussi etre saisie depuis l'administration (Administration >
# Intelligence artificielle), une cle par fournisseur, chiffree en base.
# Ce qui est saisi la-bas prime sur cette variable.
AI_API_KEY=
# Vide = le modele par defaut du fournisseur choisi. Les deux fournisseurs ne
# parlent pas le meme catalogue : un modele ecrit ici part tel quel vers celui
# que vous avez choisi. Anthropic a un defaut (claude-opus-5) ; OpenAI n'en a
# pas, choisir a votre place reviendrait a deviner — avec AI_PROVIDER=openai,
# renseignez ce champ.
AI_MODEL=
# Profondeur de reflexion, quand le modele la supporte : low | medium |
# high | xhigh | max. Vide = defaut du serveur. Un dossier de financement
# se depose une fois par an : la qualite prime sur le cout du jeton.
AI_EFFORT=high
AI_MAX_OUTPUT_TOKENS=8000
# Plafond de securite du nombre de passes d'un scenario. Ce n'est pas une
# limite d'usage : le nombre de passes suit la duree demandee. Avec les valeurs
# par defaut, la duree maximale realisable est de 681 minutes.
SCREENPLAY_MAX_PASSES=40
AI_TIMEOUT_SECONDS=180

# --- Credits IA (valeurs par defaut, surchargeables en base par l'admin) ---
AI_CREDITS_FREE=1
AI_CREDITS_PRO=300
AI_CREDITS_PRODUCER=500

# --- n8n ---
N8N_WEBHOOK_URL=http://n8n:5678/webhook/filmfund
# Cle partagee avec l'automatisation. Elle ouvre le depot de candidats de
# veille et le declenchement des taches planifiees. Vide = routes fermees.
N8N_API_KEY=
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@filmfundafrica.com
SMTP_TLS=true

# --- Stockage fichiers ---
STORAGE_URL=./storage
STORAGE_BACKEND=local

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=FilmFund Africa

# --- Observabilite du navigateur (Sentry) ---
# Vide : aucun suivi cote navigateur, et le build ne charge meme pas le
# greffon Sentry. Renseigne au moment du BUILD : la valeur est figee dans le
# bundle, la changer impose de reconstruire.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Televersement des sources au build, pour des piles d'appels lisibles. Sans
# jeton, le build reussit quand meme : les piles restent minifiees.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
