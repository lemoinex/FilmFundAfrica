# ---------------------------------------------------------------------------
# FilmFund Africa - variables d'environnement
# Copier ce fichier vers .env et renseigner les valeurs.
# NE JAMAIS committer de cle API reelle.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=FilmFund Africa
ENVIRONMENT=development
DEBUG=true
DEFAULT_LOCALE=fr

# --- Base de donnees ---
# Docker Compose : postgres ; local : localhost
POSTGRES_USER=filmfund
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=filmfund
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://filmfund:change_me_in_production@postgres:5432/filmfund
# Compatible Supabase / Neon :
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db?sslmode=require

# --- Securite ---
# OBLIGATOIRE en production : l'application refuse de demarrer avec la valeur
# de developpement ou un secret de moins de 32 caracteres.
#   openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
# IP des proxys inverses de confiance, separees par des virgules. Seules ces
# adresses sont autorisees a definir X-Forwarded-For ; laisser vide si l'API
# n'est pas derriere un proxy, sinon la limitation de debit est contournable.
TRUSTED_PROXY_IPS=

# --- Rate limiting ---
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120
# Vide : compteurs en memoire, propres a chaque processus. Avec plusieurs
# repliques, chacune applique alors sa propre limite : la limite reelle est
# multipliee par leur nombre. Renseignez REDIS_URL pour une limite partagee.
# docker compose fournit deja redis://redis:6379/0.
REDIS_URL=
# Au-dela de ce delai, l'appel a Redis est abandonne et compte en memoire :
# un Redis lent ne doit pas tenir les requetes ouvertes.
REDIS_TIMEOUT_SECONDS=0.25

# --- Taches de generation ---
# Avec REDIS_URL et un worker (`python -m app.workers.runner`), les generations
# sont executees hors requete HTTP. Sans l'un ou l'autre, l'API les execute
# elle-meme : c'est fonctionnel, mais un scenario long tient la requete ouverte.
# Duree SANS SIGNE DE VIE au-dela de laquelle une tache est consideree
# interrompue (worker disparu) : elle echoue et les credits sont rendus. Le
# worker touche la tache a chaque passe : une generation longue mais vivante
# n'est jamais prise pour une tache morte. Gardez ce seuil au-dessus de
# AI_TIMEOUT_SECONDS, qui borne la duree d'une passe.
JOB_TIMEOUT_SECONDS=900
# Age a partir duquel une tache en attente est reprise par le balayage.
JOB_STALE_SECONDS=60

# --- IA ---
# AI_PROVIDER : anthropic | openai | mock
# "mock" ne fait aucun appel reseau : utile pour les tests et la demo hors ligne.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_MAX_OUTPUT_TOKENS=8000
# Plafond de securite du nombre de passes d'un scenario. Ce n'est pas une
# limite d'usage : le nombre de passes suit la duree demandee. Avec les valeurs
# par defaut, la duree maximale realisable est de 681 minutes.
SCREENPLAY_MAX_PASSES=40
AI_TIMEOUT_SECONDS=180

# --- Credits IA (valeurs par defaut, surchargeables en base par l'admin) ---
AI_CREDITS_FREE=1
AI_CREDITS_PRO=300
AI_CREDITS_PRODUCER=500

# --- n8n ---
N8N_WEBHOOK_URL=http://n8n:5678/webhook/filmfund
N8N_API_KEY=
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@filmfundafrica.com
SMTP_TLS=true

# --- Stockage fichiers ---
STORAGE_URL=./storage
STORAGE_BACKEND=local

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=FilmFund Africa
